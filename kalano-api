
const ALLOWED_ORIGIN = "https://hakima659.github.io";

const HEADERS = {
  "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, X-Admin-Token",
  "Content-Type": "application/json; charset=utf-8",
  "Cache-Control": "no-store"
};

function response(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: HEADERS
  });
}

function isAdmin(request, env) {
  return Boolean(
    env.ADMIN_TOKEN &&
    request.headers.get("X-Admin-Token") === env.ADMIN_TOKEN
  );
}

function newId() {
  return crypto.randomUUID();
}

async function ensureTables(db) {
  await db.batch([
    db.prepare(`CREATE TABLE IF NOT EXISTS products (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      price INTEGER NOT NULL,
      active INTEGER NOT NULL DEFAULT 1
    )`),
    db.prepare(`CREATE TABLE IF NOT EXISTS orders (
      id TEXT PRIMARY KEY,
      customer_name TEXT NOT NULL,
      phone TEXT NOT NULL,
      address TEXT NOT NULL,
      postal_code TEXT,
      items_json TEXT NOT NULL,
      total INTEGER NOT NULL,
      payment_reference TEXT,
      status TEXT NOT NULL DEFAULT 'awaiting_payment',
      created_at TEXT NOT NULL
    )`)
  ]);
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";

    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: HEADERS });
    }

    if (url.origin !== "https://kalano-api.hakima09360.workers.dev" &&
        request.headers.get("Origin") &&
        request.headers.get("Origin") !== ALLOWED_ORIGIN) {
      return response({ ok: false, error: "ORIGIN_NOT_ALLOWED" }, 403);
    }

    try {
      if (request.method === "GET" && path === "/health") {
        return response({ ok: true, service: "kalano-api" });
      }

      if (!env.DB) {
        return response({ ok: false, error: "DB_NOT_CONFIGURED" }, 500);
      }

      await ensureTables(env.DB);

      if (request.method === "GET" && path === "/api/payment-info") {
        return response({
          ok: true,
          method: "card_to_card",
          cardHolder: env.CARD_HOLDER || "",
          cardNumber: env.CARD_NUMBER || ""
        });
      }

      // مدیر محصولات را از مسیر امن ثبت می‌کند.
      if (request.method === "POST" && path === "/api/admin/products") {
        if (!isAdmin(request, env)) {
          return response({ ok: false, error: "UNAUTHORIZED" }, 401);
        }

        const body = await request.json();
        const name = String(body.name || "").trim();
        const price = Number(body.price);
        const id = String(body.id || newId());

        if (!name || name.length > 200 ||
            !Number.isSafeInteger(price) || price <= 0) {
          return response({ ok: false, error: "INVALID_PRODUCT" }, 400);
        }

        await env.DB.prepare(`
          INSERT INTO products (id, name, price, active)
          VALUES (?, ?, ?, 1)
          ON CONFLICT(id) DO UPDATE SET
            name = excluded.name,
            price = excluded.price,
            active = 1
        `).bind(id, name, price).run();

        return response({ ok: true, id }, 201);
      }

      if (request.method === "GET" && path === "/api/products") {
        const result = await env.DB.prepare(`
          SELECT id, name, price
          FROM products
          WHERE active = 1
          ORDER BY name
          LIMIT 500
        `).all();

        return response({ ok: true, products: result.results });
      }

      if (request.method === "POST" && path === "/api/orders") {
        let body;
        try {
          body = await request.json();
        } catch {
          return response({ ok: false, error: "INVALID_JSON" }, 400);
        }

        const name = String(body.name || "").trim();
        const phone = String(body.phone || "").trim();
        const address = String(body.address || "").trim();
        const postalCode = String(body.postalCode || "").trim();
        const items = body.items;

        if (!name || name.length > 120 ||
            !/^[0-9+\-\s()]{8,30}$/.test(phone) ||
            !address || address.length > 1000 ||
            postalCode.length > 30) {
          return response({ ok: false, error: "INVALID_CUSTOMER_DETAILS" }, 400);
        }

        if (!Array.isArray(items) || items.length < 1 || items.length > 50) {
          return response({ ok: false, error: "INVALID_ITEMS" }, 400);
        }

        // مقدار قیمت ارسالی مرورگر نادیده گرفته می‌شود.
        const quantities = new Map();

        for (const item of items) {
          const id = String(item?.id || "");
          const quantity = Number(item?.quantity);

          if (!id || !Number.isSafeInteger(quantity) ||
              quantity < 1 || quantity > 20) {
            return response({ ok: false, error: "INVALID_ITEM" }, 400);
          }

          quantities.set(id, (quantities.get(id) || 0) + quantity);
        }

        const ids = [...quantities.keys()];
        const placeholders = ids.map(() => "?").join(",");

        const result = await env.DB.prepare(`
          SELECT id, name, price
          FROM products
          WHERE active = 1 AND id IN (${placeholders})
        `).bind(...ids).all();

        if (result.results.length !== ids.length) {
          return response({
            ok: false,
            error: "PRODUCT_NOT_FOUND_OR_INACTIVE"
          }, 400);
        }

        let total = 0;
        const finalItems = [];

        for (const product of result.results) {
          const quantity = quantities.get(product.id);
          const lineTotal = product.price * quantity;

          if (!Number.isSafeInteger(lineTotal) ||
              !Number.isSafeInteger(total + lineTotal)) {
            return response({ ok: false, error: "TOTAL_TOO_LARGE" }, 400);
          }

          total += lineTotal;
          finalItems.push({
            id: product.id,
            name: product.name,
            price: product.price,
            quantity,
            lineTotal
          });
        }

        const id = newId();
        const createdAt = new Date().toISOString();

        await env.DB.prepare(`
          INSERT INTO orders (
            id, customer_name, phone, address, postal_code,
            items_json, total, status, created_at
          ) VALUES (?, ?, ?, ?, ?, ?, ?, 'awaiting_payment', ?)
        `).bind(
          id, name, phone, address, postalCode,
          JSON.stringify(finalItems), total, createdAt
        ).run();

        return response({
          ok: true,
          order: {
            id,
            items: finalItems,
            total,
            status: "awaiting_payment",
            createdAt
          },
          payment: {
            method: "card_to_card",
            cardHolder: env.CARD_HOLDER || "",
            cardNumber: env.CARD_NUMBER || ""
          },
          message: "سفارش ثبت شد؛ پس از واریز، کد پیگیری را ثبت کنید."
        }, 201);
      }

      const paymentMatch = path.match(
        /^\/api\/orders\/([a-f0-9-]{36})\/payment-reference$/i
      );

      if (request.method === "POST" && paymentMatch) {
        const body = await request.json();
        const reference = String(body.reference || "").trim();

        if (reference.length < 3 || reference.length > 100) {
          return response({ ok: false, error: "INVALID_REFERENCE" }, 400);
        }

        const result = await env.DB.prepare(`
          UPDATE orders
          SET payment_reference = ?, status = 'payment_reported'
          WHERE id = ? AND status = 'awaiting_payment'
        `).bind(reference, paymentMatch[1]).run();

        if (!result.meta.changes) {
          return response({ ok: false, error: "ORDER_NOT_FOUND_OR_ALREADY_REPORTED" }, 404);
        }

        return response({
          ok: true,
          status: "payment_reported",
          message: "ثبت شد؛ پرداخت هنوز باید توسط مدیر بررسی شود."
        });
      }

      if (request.method === "GET" && path === "/api/admin/orders") {
        if (!isAdmin(request, env)) {
          return response({ ok: false, error: "UNAUTHORIZED" }, 401);
        }

        const result = await env.DB.prepare(`
          SELECT id, customer_name, phone, address, postal_code,
                 items_json, total, payment_reference, status, created_at
          FROM orders
          ORDER BY created_at DESC
          LIMIT 100
        `).all();

        return response({ ok: true, orders: result.results });
      }

      const statusMatch = path.match(
        /^\/api\/admin\/orders\/([a-f0-9-]{36})\/status$/i
      );

      if (request.method === "POST" && statusMatch) {
        if (!isAdmin(request, env)) {
          return response({ ok: false, error: "UNAUTHORIZED" }, 401);
        }

        const body = await request.json();
        const status = String(body.status || "");
        const allowed = [
          "awaiting_payment", "payment_reported",
          "paid", "processing", "shipped", "cancelled"
        ];

        if (!allowed.includes(status)) {
          return response({ ok: false, error: "INVALID_STATUS" }, 400);
        }

        // تأیید پرداخت فقط پس از بررسی واقعی واریز انجام شود.
        if (status === "paid") {
          const order = await env.DB.prepare(`
            SELECT status, payment_reference
            FROM orders WHERE id = ?
          `).bind(statusMatch[1]).first();

          if (!order || order.status !== "payment_reported" ||
              !order.payment_reference) {
            return response({
              ok: false,
              error: "PAYMENT_REPORT_REQUIRED"
            }, 409);
          }
        }

        const result = await env.DB.prepare(`
          UPDATE orders SET status = ? WHERE id = ?
        `).bind(status, statusMatch[1]).run();

        if (!result.meta.changes) {
          return response({ ok: false, error: "ORDER_NOT_FOUND" }, 404);
        }

        return response({ ok: true, status });
      }

      return response({ ok: false, error: "NOT_FOUND" }, 404);
    } catch {
      return response({ ok: false, error: "INTERNAL_ERROR" }, 500);
    }
  }
};
