
const corsHeaders = {
  "Access-Control-Allow-Origin": "https://hakima659.github.io",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, X-Admin-Token",
  "Content-Type": "application/json; charset=utf-8",
  "Cache-Control": "no-store"
};

function response(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: corsHeaders
  });
}

function makeId() {
  return crypto.randomUUID();
}

function isAdmin(request, env) {
  const token = request.headers.get("X-Admin-Token");
  return Boolean(env.ADMIN_TOKEN && token && token === env.ADMIN_TOKEN);
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;
    const method = request.method;

    if (method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders
      });
    }

    try {
      // بررسی فعال بودن API
      if (method === "GET" && path === "/health") {
        return response({
          ok: true,
          service: "kalano-api",
          message: "بک‌اند کالانو فعال است"
        });
      }

      // اطلاعات کارت پرداخت
      if (method === "GET" && path === "/api/payment-info") {
        const configured = Boolean(
          env.CARD_HOLDER && env.CARD_NUMBER
        );

        return response({
          ok: true,
          cardHolder: env.CARD_HOLDER || "",
          cardNumber: env.CARD_NUMBER || "",
          configured
        });
      }

      // ثبت سفارش
      if (method === "POST" && path === "/api/orders") {
        if (!env.DB) {
          return response({
            ok: false,
            error: "پایگاه داده تنظیم نشده است"
          }, 500);
        }

        let body;

        try {
          body = await request.json();
        } catch {
          return response({
            ok: false,
            error: "اطلاعات ارسالی معتبر نیست"
          }, 400);
        }

        const name = String(body.name || "").trim();
        const phone = String(body.phone || "").trim();
        const address = String(body.address || "").trim();
        const postalCode = String(body.postalCode || "").trim();
        const items = body.items;
        const total = Number(body.total);

        if (
          !name || name.length > 120 ||
          !phone || phone.length > 30 ||
          !address || address.length > 1000 ||
          postalCode.length > 30
        ) {
          return response({
            ok: false,
            error: "نام، تلفن یا نشانی نامعتبر است"
          }, 400);
        }

        if (
          !Array.isArray(items) ||
          items.length === 0 ||
          items.length > 50
        ) {
          return response({
            ok: false,
            error: "سبد خرید معتبر نیست"
          }, 400);
        }

        const validItems = items.every(item =>
          item &&
          typeof item.name === "string" &&
          item.name.trim().length > 0 &&
          item.name.length <= 200 &&
          Number.isSafeInteger(Number(item.quantity)) &&
          Number(item.quantity) >= 1 &&
          Number(item.quantity) <= 100
        );

        if (!validItems) {
          return response({
            ok: false,
            error: "اقلام سفارش معتبر نیستند"
          }, 400);
        }

        if (
          !Number.isSafeInteger(total) ||
          total <= 0 ||
          total > 100000000000
        ) {
          return response({
            ok: false,
            error: "مبلغ سفارش معتبر نیست"
          }, 400);
        }

        // توجه: پیش از فروش واقعی باید مبلغ
        // با قیمت معتبر محصولات در سمت سرور محاسبه شود.
        const id = makeId();
        const createdAt = new Date().toISOString();

        await env.DB.prepare(`
          INSERT INTO orders (
            id,
            customer_name,
            phone,
            address,
            postal_code,
            items_json,
            total,
            payment_reference,
            status,
            created_at
          )
          VALUES (?, ?, ?, ?, ?, ?, ?, NULL, 'awaiting_payment', ?)
        `).bind(
          id,
          name,
          phone,
          address,
          postalCode,
          JSON.stringify(items),
          total,
          createdAt
        ).run();

        return response({
          ok: true,
          orderId: id,
          status: "awaiting_payment",
          message: "سفارش ثبت شد؛ پس از پرداخت، کد پیگیری را ارسال کنید"
        }, 201);
      }

      // ثبت کد پیگیری پرداخت
      const paymentMatch = path.match(
        /^\/api\/orders\/([a-f0-9-]{36})\/payment-reference$/i
      );

      if (method === "POST" && paymentMatch) {
        if (!env.DB) {
          return response({
            ok: false,
            error: "پایگاه داده تنظیم نشده است"
          }, 500);
        }

        let body;

        try {
          body = await request.json();
        } catch {
          return response({
            ok: false,
            error: "اطلاعات ارسالی معتبر نیست"
          }, 400);
        }

        const reference = String(body.reference || "").trim();

        if (reference.length < 3 || reference.length > 100) {
          return response({
            ok: false,
            error: "کد پیگیری معتبر وارد کنید"
          }, 400);
        }

        const result = await env.DB.prepare(`
          UPDATE orders
          SET payment_reference = ?,
              status = 'payment_reported'
          WHERE id = ?
            AND status = 'awaiting_payment'
        `).bind(reference, paymentMatch[1]).run();

        if (!result.meta.changes) {
          return response({
            ok: false,
            error: "سفارش پیدا نشد یا قبلاً گزارش پرداخت ثبت شده است"
          }, 404);
        }

        return response({
          ok: true,
          status: "payment_reported",
          message: "گزارش پرداخت ثبت شد؛ بررسی نهایی دستی است"
        });
      }

      // دریافت سفارش‌ها برای مدیر
      if (method === "GET" && path === "/api/admin/orders") {
        if (!isAdmin(request, env)) {
          return response({
            ok: false,
            error: "دسترسی غیرمجاز"
          }, 401);
        }

        if (!env.DB) {
          return response({
            ok: false,
            error: "پایگاه داده تنظیم نشده است"
          }, 500);
        }

        const result = await env.DB.prepare(`
          SELECT
            id,
            customer_name,
            phone,
            address,
            postal_code,
            items_json,
            total,
            payment_reference,
            status,
            created_at
          FROM orders
          ORDER BY created_at DESC
          LIMIT 100
        `).all();

        return response({
          ok: true,
          orders: result.results
        });
      }

      // تغییر وضعیت سفارش توسط مدیر
      const statusMatch = path.match(
        /^\/api\/admin\/orders\/([a-f0-9-]{36})\/status$/i
      );

      if (method === "POST" && statusMatch) {
        if (!isAdmin(request, env)) {
          return response({
            ok: false,
            error: "دسترسی غیرمجاز"
          }, 401);
        }

        if (!env.DB) {
          return response({
            ok: false,
            error: "پایگاه داده تنظیم نشده است"
          }, 500);
        }

        let body;

        try {
          body = await request.json();
        } catch {
          return response({
            ok: false,
            error: "اطلاعات ارسالی معتبر نیست"
          }, 400);
        }

        const allowed = [
          "awaiting_payment",
          "payment_reported",
          "paid",
          "processing",
          "shipped",
          "cancelled"
        ];

        const status = String(body.status || "");

        if (!allowed.includes(status)) {
          return response({
            ok: false,
            error: "وضعیت نامعتبر است"
          }, 400);
        }

        const result = await env.DB.prepare(`
          UPDATE orders
          SET status = ?
          WHERE id = ?
        `).bind(status, statusMatch[1]).run();

        if (!result.meta.changes) {
          return response({
            ok: false,
            error: "سفارش پیدا نشد"
          }, 404);
        }

        return response({
          ok: true,
          status
        });
      }

      return response({
        ok: false,
        error: "مسیر پیدا نشد"
      }, 404);

    } catch (error) {
      return response({
        ok: false,
        error: "خطای داخلی سرور؛ تنظیمات و پایگاه داده را بررسی کنید"
      }, 500);
    }
  }
};
