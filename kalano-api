
const ALLOWED_ORIGIN = "https://hakima659.github.io";
const MAX_RECEIPT_CHARS = 450_000;

function cors(origin) {
  return {
    "Access-Control-Allow-Origin":
      origin === ALLOWED_ORIGIN ? origin : ALLOWED_ORIGIN,
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers":
      "Content-Type, X-Admin-Token",
    "Content-Type": "application/json; charset=utf-8",
    "Cache-Control": "no-store",
    "Vary": "Origin"
  };
}

function reply(data, status, origin) {
  return new Response(JSON.stringify(data), {
    status,
    headers: cors(origin)
  });
}

async function initDB(db) {
  await db.prepare(`
    CREATE TABLE IF NOT EXISTS orders (
      id TEXT PRIMARY KEY,
      customer_name TEXT NOT NULL,
      mobile TEXT NOT NULL,
      description TEXT NOT NULL,
      amount INTEGER NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending',
      receipt TEXT,
      created_at TEXT NOT NULL
    )
  `).run();
}

function makeId() {
  return crypto.randomUUID();
}

export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors(origin)
      });
    }

    if (!env.DB) {
      return reply({ ok: false, error: "DB_NOT_CONFIGURED" }, 500, origin);
    }

    try {
      await initDB(env.DB);

      if (path === "/health" && request.method === "GET") {
        return reply({ ok: true, service: "kalano-api" }, 200, origin);
      }

      if (path === "/api/payment-info" && request.method === "GET") {
        return reply({
          ok: true,
          method: "card_to_card",
          cardHolder: env.CARD_HOLDER || "",
          cardNumber: env.CARD_NUMBER || "",
          instructions: "پس از واریز، رسید را برای سفارش ثبت کنید."
        }, 200, origin);
      }

      if (path === "/api/orders" && request.method === "POST") {
        const body = await request.json();

        const customerName = String(body.customerName || "").trim();
        const mobile = String(body.mobile || "").trim();
        const description = String(body.description || "").trim();
        const amount = Number(body.amount);

        if (!customerName || !mobile || !description) {
          return reply({
            ok: false,
            error: "نام، موبایل و شرح سفارش الزامی است."
          }, 400, origin);
        }

        if (!/^[0-9+\-\s()]{8,20}$/.test(mobile)) {
          return reply({ ok: false, error: "شماره موبایل معتبر نیست." }, 400, origin);
        }

        if (!Number.isSafeInteger(amount) || amount <= 0) {
          return reply({ ok: false, error: "مبلغ سفارش معتبر نیست." }, 400, origin);
        }

        const id = makeId();
        const createdAt = new Date().toISOString();

        await env.DB.prepare(`
          INSERT INTO orders
          (id, customer_name, mobile, description, amount, status, created_at)
          VALUES (?, ?, ?, ?, ?, 'pending', ?)
        `).bind(
          id, customerName, mobile, description, amount, createdAt
        ).run();

        return reply({
          ok: true,
          order: {
            id,
            customerName,
            mobile,
            description,
            amount,
            status: "pending",
            createdAt
          },
          message: "سفارش ثبت شد. پس از پرداخت، رسید را ارسال کنید."
        }, 201, origin);
      }

      const receiptMatch = path.match(/^\/api\/orders\/([a-f0-9-]+)\/receipt$/i);

      if (receiptMatch && request.method === "POST") {
        const id = receiptMatch[1];
        const body = await request.json();
        const receipt = String(body.receipt || "");

        if (
          !receipt.startsWith("data:image/") ||
          !/^data:image\/(jpeg|jpg|png|webp);base64,/i.test(receipt)
        ) {
          return reply({
            ok: false,
            error: "فقط تصویر JPG، PNG یا WEBP پذیرفته می‌شود."
          }, 400, origin);
        }

        if (receipt.length > MAX_RECEIPT_CHARS) {
          return reply({
            ok: false,
            error: "حجم رسید زیاد است؛ تصویر را کوچک‌تر کنید."
          }, 413, origin);
        }

        const result = await env.DB.prepare(`
          UPDATE orders
          SET receipt = ?
          WHERE id = ? AND status = 'pending'
        `).bind(receipt, id).run();

        if (!result.meta.changes) {
          return reply({
            ok: false,
            error: "سفارش پیدا نشد یا دیگر در انتظار بررسی نیست."
          }, 404, origin);
        }

        return reply({
          ok: true,
          message: "رسید ثبت شد و در انتظار بررسی مدیر است."
        }, 200, origin);
      }

      if (path === "/api/admin/orders" && request.method === "GET") {
        if (
          !env.ADMIN_TOKEN ||
          request.headers.get("X-Admin-Token") !== env.ADMIN_TOKEN
        ) {
          return reply({ ok: false, error: "UNAUTHORIZED" }, 401, origin);
        }

        const result = await env.DB.prepare(`
          SELECT id, customer_name, mobile, description, amount,
                 status, receipt, created_at
          FROM orders
          ORDER BY created_at DESC
          LIMIT 100
        `).all();

        return reply({ ok: true, orders: result.results }, 200, origin);
      }

      const statusMatch = path.match(/^\/api\/admin\/orders\/([a-f0-9-]+)\/status$/i);

      if (statusMatch && request.method === "POST") {
        if (
          !env.ADMIN_TOKEN ||
          request.headers.get("X-Admin-Token") !== env.ADMIN_TOKEN
        ) {
          return reply({ ok: false, error: "UNAUTHORIZED" }, 401, origin);
        }

        const body = await request.json();
        const status = String(body.status || "");
        const allowed = ["pending", "approved", "rejected"];

        if (!allowed.includes(status)) {
          return reply({ ok: false, error: "وضعیت نامعتبر است." }, 400, origin);
        }

        const result = await env.DB.prepare(`
          UPDATE orders SET status = ? WHERE id = ?
        `).bind(status, statusMatch[1]).run();

        if (!result.meta.changes) {
          return reply({ ok: false, error: "سفارش پیدا نشد." }, 404, origin);
        }

        return reply({ ok: true, message: "وضعیت سفارش به‌روزرسانی شد." }, 200, origin);
      }

      return reply({ ok: false, error: "NOT_FOUND" }, 404, origin);
    } catch (error) {
      return reply({
        ok: false,
        error: "INTERNAL_ERROR"
      }, 500, origin);
    }
  }
};
