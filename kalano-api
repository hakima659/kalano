const ALLOWED_ORIGIN = "https://hakima659.github.io";

const HEADERS = {
  "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, X-Admin-Token",
  "Content-Type": "application/json; charset=utf-8",
  "Cache-Control": "no-store",
  "Vary": "Origin"
};

function response(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: HEADERS
  });
}

function isAdmin(request, env) {
  const token = env.ADMIN_TOKEN;
  return Boolean(
    token &&
    request.headers.get("X-Admin-Token") &&
    request.headers.get("X-Admin-Token") === token
  );
}

function newId() {
  return crypto.randomUUID();
}

async function ensureTables(db) {
  await db.batch([
    db.prepare(`CREATE TABLE IF NOT EXISTS products (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      price INTEGER NOT NULL CHECK(price > 0),
      active INTEGER NOT NULL DEFAULT 1
    )`),
    db.prepare(`CREATE TABLE IF NOT EXISTS orders (
      id TEXT PRIMARY KEY,
      customer_name TEXT NOT NULL,
      phone TEXT NOT NULL,
      address TEXT NOT NULL,
      postal_code TEXT,
      items_json TEXT NOT NULL,
      total INTEGER NOT NULL,
      payment_reference TEXT,
      status TEXT NOT NULL DEFAULT 'awaiting_payment',
      created_at TEXT NOT NULL
    )`)
  ]);
}

function validOrigin(request) {
  const origin = request.headers.get("Origin");

  // درخواست مستقیم مرورگر بدون Origin مجاز نیست؛
  // درخواست‌های سرور به سرور بدون Origin قابل قبول‌اند.
  return !origin || origin === ALLOWED_ORIGIN;
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";

    if (request.method === "OPTIONS") {
      if (!validOrigin(request)) {
        return response({ ok: false, error: "ORIGIN_NOT_ALLOWED" }, 403);
      }

      return new Response(null, {
        status: 204,
        headers: HEADERS
      });
    }

    if (!validOrigin(request)) {
      return response({ ok: false, error: "ORIGIN_NOT_ALLOWED" }, 403);
    }

    try {
      if (request.method === "GET" && path === "/health") {
        return response({
          ok: true,
          service: "kalano-api",
          databaseConfigured: Boolean(env.DB)
        });
      }

      if (!env.DB) {
        return response({
          ok: false,
          error: "DB_NOT_CONFIGURED",
          message: "اتصال D1 با نام DB تنظیم نشده است."
        }, 500);
      }

      await ensureTables(env.DB);

      if (request.method === "GET" && path === "/api/payment-info") {
        return response({
          ok: true,
          method: "card_to_card",
          cardHolder: env.CARD_HOLDER || "",
          cardNumber: env.CARD_NUMBER || "",
          paymentIsAutomatic: false
        });
      }

      // فهرست محصولات فعال
      if (request.method === "GET" && path === "/api/products") {
        const result = await env.DB.prepare(`
          SELECT id, name, price
          FROM products
          WHERE active = 1
          ORDER BY name
          LIMIT 500
        `).all();

        return response({
          ok: true,
          products: result.results
        });
      }

      // افزودن یا به‌روزرسانی محصول توسط مدیر
      if (request.method === "POST" &&
          path === "/api/admin/products") {
        if (!isAdmin(request, env)) {
          return response({
            ok: false,
            error: "UNAUTHORIZED"
          }, 401);
        }

        let body;
        try {
          body = await request.json();
        } catch {
          return response({ ok: false, error: "INVALID_JSON" }, 400);
        }

        const name = String(body.name || "").trim();
        const price = Number(body.price);
        const id = String(body.id || newId()).trim();

        if (!name || name.length > 200 ||
            !Number.isSafeInteger(price) || price <= 0 ||
            id.length > 100) {
          return response({
            ok: false,
            error: "INVALID_PRODUCT"
          }, 400);
        }

        await env.DB.prepare(`
          INSERT INTO products (id, name, price, active)
          VALUES (?, ?, ?, 1)
          ON CONFLICT(id) DO UPDATE SET
            name = excluded.name,
            price = excluded.price,
            active = 1
        `).bind(id, name, price).run();

        return response({ ok: true, id }, 201);
      }

      // غیرفعال کردن محصول توسط مدیر
      if (request.method === "POST" &&
          path === "/api/admin/products/deactivate") {
        if (!isAdmin(request, env)) {
          return response({ ok: false, error: "UNAUTHORIZED" }, 401);
        }

        const body = await request.json();
        const id = String(body.id || "").trim();

        if (!id) {
          return response({ ok: false, error: "INVALID_PRODUCT_ID" }, 400);
        }

        const result = await env.DB.prepare(`
          UPDATE products SET active = 0 WHERE id = ?
        `).bind(id).run();

        if (!result.meta.changes) {
          return response({ ok: false, error: "PRODUCT_NOT_FOUND" }, 404);
        }

        return response({ ok: true });
      }

      // ثبت سفارش با قیمت محاسبه‌شده از دیتابیس
      if (request.method === "POST" && path === "/api/orders") {
        let body;
        try {
          body = await request.json();
        } catch {
          return response({ ok: false, error: "INVALID_JSON" }, 400);
        }

        const name = String(body.name || "").trim();
        const phone = String(body.phone || "").trim();
        const address = String(body.address || "").trim();
        const postalCode = String(body.postalCode || "").trim();
        const items = body.items;

        if (!name || name.length > 120 ||
            !/^[0-9+\-\s()]{8,30}$/.test(phone) ||
            !address || address.length > 1000 ||
            postalCode.length > 30) {
          return response({
            ok: false,
            error: "INVALID_CUSTOMER_DETAILS"
          }, 400);
        }

        if (!Array.isArray(items) ||
            items.length < 1 || items.length > 50) {
          return response({ ok: false, error: "INVALID_ITEMS" }, 400);
        }

        const quantities = new Map();

        for (const item of items) {
          const id = String(item?.id || "").trim();
          const quantity = Number(item?.quantity);

          if (!id || id.length > 100 ||
              !Number.isSafeInteger(quantity) ||
              quantity < 1 || quantity > 20) {
            return response({ ok: false, error: "INVALID_ITEM" }, 400);
          }

          const nextQuantity = (quantities.get(id) || 0) + quantity;

          if (nextQuantity > 20) {
            return response({ ok: false, error: "QUANTITY_TOO_LARGE" }, 400);
          }

          quantities.set(id, nextQuantity);
        }

        const ids = [...quantities.keys()];
        const placeholders = ids.map(() => "?").join(",");

        const result = await env.DB.prepare(`
          SELECT id, name, price
          FROM products
          WHERE active = 1 AND id IN (${placeholders})
        `).bind(...ids).all();

        if (result.results.length !== ids.length) {
          return response({
            ok: false,
            error: "PRODUCT_NOT_FOUND_OR_INACTIVE"
          }, 400);
        }

        let total = 0;
        const finalItems = [];

        for (const product of result.results) {
          const quantity = quantities.get(product.id);
          const lineTotal = product.price * quantity;

          if (!Number.isSafeInteger(lineTotal) ||
              !Number.isSafeInteger(total + lineTotal)) {
            return response({ ok: false, error: "TOTAL_TOO_LARGE" }, 400);
          }

          total += lineTotal;

          finalItems.push({
            id: product.id,
            name: product.name,
            price: product.price,
            quantity,
            lineTotal
          });
        }

        const id = newId();
        const createdAt = new Date().toISOString();

        await env.DB.prepare(`
          INSERT INTO orders (
            id, customer_name, phone, address, postal_code,
            items_json, total, status, created_at
          ) VALUES (?, ?, ?, ?, ?, ?, ?, 'awaiting_payment', ?)
        `).bind(
          id,
          name,
          phone,
          address,
          postalCode,
          JSON.stringify(finalItems),
          total,
          createdAt
        ).run();

        return response({
          ok: true,
          order: {
            id,
            items: finalItems,
            total,
            status: "awaiting_payment",
            createdAt
          },
          payment: {
            method: "card_to_card",
            cardHolder: env.CARD_HOLDER || "",
            cardNumber: env.CARD_NUMBER || "",
            paymentIsAutomatic: false
          },
          message: "سفارش ثبت شد. پرداخت هنوز تأیید نشده است."
        }, 201);
      }

      // ارسال کد پیگیری پرداخت؛ این کار به‌تنهایی اثبات پرداخت نیست.
      const paymentMatch = path.match(
        /^\/api\/orders\/([a-f0-9-]{36})\/payment-reference$/i
      );

      if (request.method === "POST" && paymentMatch) {
        let body;
        try {
          body = await request.json();
        } catch {
          return response({ ok: false, error: "INVALID_JSON" }, 400);
        }

        const reference = String(body.reference || "").trim();

        if (reference.length < 3 || reference.length > 100) {
          return response({ ok: false, error: "INVALID_REFERENCE" }, 400);
        }

        const result = await env.DB.prepare(`
          UPDATE orders
          SET payment_reference = ?, status = 'payment_reported'
          WHERE id = ? AND status = 'awaiting_payment'
        `).bind(reference, paymentMatch[1]).run();

        if (!result.meta.changes) {
          return response({
            ok: false,
            error: "ORDER_NOT_FOUND_OR_ALREADY_REPORTED"
          }, 404);
        }

        return response({
          ok: true,
          status: "payment_reported",
          message: "گزارش دریافت شد؛ مدیر باید واریز را بررسی کند."
        });
      }

      // مشاهده سفارش‌ها توسط مدیر
      if (request.method === "GET" && path === "/api/admin/orders") {
        if (!isAdmin(request, env)) {
          return response({ ok: false, error: "UNAUTHORIZED" }, 401);
        }

        const result = await env.DB.prepare(`
          SELECT id, customer_name, phone, address, postal_code,
                 items_json, total, payment_reference, status, created_at
          FROM orders
          ORDER BY created_at DESC
          LIMIT 100
        `).all();

        return response({ ok: true, orders: result.results });
      }

      // تغییر وضعیت سفارش توسط مدیر
      const statusMatch = path.match(
        /^\/api\/admin\/orders\/([a-f0-9-]{36})\/status$/i
      );

      if (request.method === "POST" && statusMatch) {
        if (!isAdmin(request, env)) {
          return response({ ok: false, error: "UNAUTHORIZED" }, 401);
        }

        let body;
        try {
          body = await request.json();
        } catch {
          return response({ ok: false, error: "INVALID_JSON" }, 400);
        }

        const status = String(body.status || "");
        const allowed = [
          "awaiting_payment",
          "payment_reported",
          "paid",
          "processing",
          "shipped",
          "cancelled"
        ];

        if (!allowed.includes(status)) {
          return response({ ok: false, error: "INVALID_STATUS" }, 400);
        }

        const order = await env.DB.prepare(`
          SELECT status, payment_reference
          FROM orders
          WHERE id = ?
        `).bind(statusMatch[1]).first();

        if (!order) {
          return response({ ok: false, error: "ORDER_NOT_FOUND" }, 404);
        }

        if (status === "paid" &&
            (order.status !== "payment_reported" ||
             !order.payment_reference)) {
          return response({
            ok: false,
            error: "PAYMENT_REPORT_REQUIRED"
          }, 409);
        }

        const result = await env.DB.prepare(`
          UPDATE orders SET status = ? WHERE id = ?
        `).bind(status, statusMatch[1]).run();

        if (!result.meta.changes) {
          return response({ ok: false, error: "ORDER_UPDATE_FAILED" }, 500);
        }

        return response({ ok: true, status });
      }

      return response({
        ok: false,
        error: "NOT_FOUND"
      }, 404);

    } catch (error) {
      // جزئیات خطا به کاربر عمومی نمایش داده نمی‌شود.
      console.error("Kalano API error:", error);

      return response({
        ok: false,
        error: "INTERNAL_ERROR",
        message: "خطای داخلی رخ داد؛ گزارش خطا را در Cloudflare بررسی کنید."
      }, 500);
    }
  }
};
