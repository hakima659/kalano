  free: {
    name: "رایگان",
    price: 0,
    limit: 2
  },
  bronze: {
    name: "برنزی",
    price: 290000,
    limit: 20
  },
  silver: {
    name: "نقره‌ای",
    price: 590000,
    limit: 100
  },
  gold: {
    name: "طلایی",
    price: 1290000,
    limit: 10000
  },
  diamond: {
    name: "الماسی",
    price: 2900000,
    limit: 10000
  },
  special: {
