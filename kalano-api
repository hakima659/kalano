const ALLOWED_ORIGIN = "https://hakima659.github.io";

const PLANS = {
  free: { name: "رایگان", price: 0, limit: 2 },
  bronze: { name: "برنزی", price: 290000, limit: 20 },
  silver: { name: "نقره‌ای", price: 590000, limit: 100 },
  gold: { name: "طلایی", price: 1290000, limit: 10000 },
  diamond: { name: "الماسی", price: 2900000, limit: 10000 },
  special: { name: "ویژه", price: 5900000, limit: 10000 }
};

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers":
        "Content-Type, Authorization, X-Admin-Token",
      "Cache-Control": "no-store"
    }
  });

const id = () => crypto.randomUUID();
const now = () => new Date().toISOString();

function phone(value) {
  let p = String(value || "").replace(/[\s()-]/g, "");
  if (p.startsWith("+98")) p = "0" + p.slice(3);
  if (p.startsWith("0098")) p = "0" + p.slice(4);
  return p;
}

function clean(value, max = 500) {
  return String(value ?? "").trim().slice(0, max);
}

function base64(bytes) {
  let s = "";
  for (const b of bytes) s += String.fromCharCode(b);
  return btoa(s);
}

async function digest(value) {
  return base64(
    new Uint8Array(
      await crypto.subtle.digest(
        "SHA-256",
        new TextEncoder().encode(value)
      )
    )
  );
}

async function makePassword(password) {
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );
  const bits = await crypto.subtle.deriveBits(
    { name: "PBKDF2", salt, iterations: 100000, hash: "SHA-256" },
    key,
    256
  );
  return { salt: base64(salt), hash: base64(new Uint8Array(bits)) };
}

async function checkPassword(password, saltText, expected) {
  const salt = Uint8Array.from(atob(saltText), c => c.charCodeAt(0));
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );
  const bits = await crypto.subtle.deriveBits(
    { name: "PBKDF2", salt, iterations: 100000, hash: "SHA-256" },
    key,
    256
  );
  return base64(new Uint8Array(bits)) === expected;
}

async function tables(db) {
  await db.batch([
    db.prepare(`CREATE TABLE IF NOT EXISTS users (
      id TEXT PRIMARY KEY,
      phone TEXT NOT NULL UNIQUE,
      password_salt TEXT NOT NULL,
      password_hash TEXT NOT NULL,
      created_at TEXT NOT NULL
    )`),
    db.prepare(`CREATE TABLE IF NOT EXISTS sessions (
      token_hash TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      expires_at TEXT NOT NULL,
      created_at TEXT NOT NULL
    )`),
    db.prepare(`CREATE TABLE IF NOT EXISTS listings (
      id TEXT PRIMARY KEY,
      seller_id TEXT NOT NULL,
      title TEXT NOT NULL,
      description TEXT NOT NULL,
      category TEXT NOT NULL,
      price INTEGER NOT NULL DEFAULT 0,
      city TEXT NOT NULL,
      image_url TEXT NOT NULL DEFAULT '',
      contact_phone TEXT NOT NULL DEFAULT '',
      status TEXT NOT NULL DEFAULT 'pending',
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    )`),
    db.prepare(`CREATE TABLE IF NOT EXISTS subscriptions (
      id TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      plan TEXT NOT NULL,
      starts_at TEXT NOT NULL,
      expires_at TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'active',
      created_at TEXT NOT NULL
    )`),
    db.prepare(`CREATE TABLE IF NOT EXISTS subscription_requests (
      id TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      plan TEXT NOT NULL,
      amount INTEGER NOT NULL,
      payment_reference TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending',
      created_at TEXT NOT NULL,
      reviewed_at TEXT
    )`)
  ]);

  try {
    await db.prepare(
      "ALTER TABLE listings ADD COLUMN contact_phone TEXT NOT NULL DEFAULT ''"
    ).run();
  } catch (e) {
    if (!String(e.message || e).toLowerCase().includes("duplicate column")) {
      throw e;
    }
  }
}

async function userFrom(request, env) {
  const match = (request.headers.get("Authorization") || "")
    .match(/^Bearer\s+(.+)$/i);
  if (!match) return null;

  return await env.DB.prepare(`
    SELECT u.id, u.phone
    FROM sessions s
    JOIN users u ON u.id = s.user_id
    WHERE s.token_hash = ? AND s.expires_at > ?
  `).bind(await digest(match[1]), now()).first();
}

async function newSession(db, userId) {
  const token = base64(crypto.getRandomValues(new Uint8Array(32)))
    .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
  const created = new Date();
  const expires = new Date(created.getTime() + 30 * 86400000);

  await db.prepare(`
    INSERT INTO sessions (token_hash,user_id,expires_at,created_at)
    VALUES (?,?,?,?)
  `).bind(
    await digest(token),
    userId,
    expires.toISOString(),
    created.toISOString()
  ).run();

  return token;
}

async function currentPlan(db, userId) {
  const s = await db.prepare(`
    SELECT plan, expires_at FROM subscriptions
    WHERE user_id = ? AND status = 'active' AND expires_at > ?
    ORDER BY expires_at DESC LIMIT 1
  `).bind(userId, now()).first();

  if (s && PLANS[s.plan]) {
    return { id: s.plan, ...PLANS[s.plan], expiresAt: s.expires_at };
  }
  return { id: "free", ...PLANS.free, expiresAt: null };
}

async function listingCount(db, userId) {
  const r = await db.prepare(`
    SELECT COUNT(*) AS n FROM listings
    WHERE seller_id = ? AND status IN ('pending','published')
  `).bind(userId).first();
  return Number(r?.n || 0);
}

function admin(request, env) {
  const a = request.headers.get("X-Admin-Token");
  return Boolean(env.ADMIN_TOKEN && a && a === env.ADMIN_TOKEN);
}

async function route(request, env) {
  const url = new URL(request.url);
  const path = url.pathname.replace(/\/+$/, "") || "/";
  const method = request.method;
  const origin = request.headers.get("Origin");

  if (origin && origin !== ALLOWED_ORIGIN) {
    return json({ ok: false, error: "ORIGIN_NOT_ALLOWED" }, 403);
  }

  if (method === "OPTIONS") {
    return new Response(null, {
      status: 204,
      headers: {
        "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers":
          "Content-Type, Authorization, X-Admin-Token",
        "Access-Control-Max-Age": "86400"
      }
    });
  }

  if (path === "/health" && method === "GET") {
    return json({ ok: true, service: "kalano-api" });
  }

  if (!env.DB) return json({ ok: false, error: "DB_NOT_CONFIGURED" }, 500);
  await tables(env.DB);
  const db = env.DB;

  if (path === "/api/plans" && method === "GET") {
    return json({
      ok: true,
      plans: Object.entries(PLANS).map(([key, value]) => ({
        id: key,
        ...value,
        durationDays: key === "free" ? 0 : 30
      }))
    });
  }

  if (path === "/api/payment-info" && method === "GET") {
    return json({
      ok: true,
      cardHolder: env.CARD_HOLDER || "",
      cardNumber: env.CARD_NUMBER || "",
      paymentIsAutomatic: false
    });
  }

  if (path === "/api/register" && method === "POST") {
    const b = await request.json();
    const p = phone(b.phone);
    const password = String(b.password || "");

    if (!/^09\d{9}$/.test(p)) {
      return json({ ok: false, error: "INVALID_PHONE" }, 400);
    }
    if (password.length < 8 || password.length > 128) {
      return json({ ok: false, error: "PASSWORD_LENGTH" }, 400);
    }
    if (await db.prepare("SELECT id FROM users WHERE phone=?").bind(p).first()) {
      return json({ ok: false, error: "PHONE_EXISTS" }, 409);
    }

    const hashed = await makePassword(password);
    const uid = id();
    await db.prepare(`
      INSERT INTO users (id,phone,password_salt,password_hash,created_at)
      VALUES (?,?,?,?,?)
    `).bind(uid, p, hashed.salt, hashed.hash, now()).run();

    return json({
      ok: true,
      token: await newSession(db, uid),
      user: { id: uid, phone: p }
    }, 201);
  }

  if (path === "/api/login" && method === "POST") {
    const b = await request.json();
    const p = phone(b.phone);
    const u = await db.prepare(
      "SELECT * FROM users WHERE phone=?"
    ).bind(p).first();

    if (!u || !(await checkPassword(
      String(b.password || ""), u.password_salt, u.password_hash
    ))) {
      return json({ ok: false, error: "INVALID_CREDENTIALS" }, 401);
    }

    return json({
      ok: true,
      token: await newSession(db, u.id),
      user: { id: u.id, phone: u.phone }
    });
  }

  if (path === "/api/logout" && method === "POST") {
    const m = (request.headers.get("Authorization") || "")
      .match(/^Bearer\s+(.+)$/i);
    if (m) {
      await db.prepare("DELETE FROM sessions WHERE token_hash=?")
        .bind(await digest(m[1])).run();
    }
    return json({ ok: true });
  }

  if (path === "/api/me" && method === "GET") {
    const u = await userFrom(request, env);
    if (!u) return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    const plan = await currentPlan(db, u.id);
    const count = await listingCount(db, u.id);
    return json({
      ok: true, user: u, plan, listingCount: count,
      remainingListings: Math.max(0, plan.limit - count)
    });
  }

  if (path === "/api/categories" && method === "GET") {
    const r = await db.prepare(`
      SELECT category, COUNT(*) AS count FROM listings
      WHERE status='published'
      GROUP BY category ORDER BY count DESC, category ASC
    `).all();
    return json({ ok: true, categories: r.results });
  }

  if (path === "/api/listings" && method === "GET") {
    const where = ["l.status='published'"];
    const args = [];
    const q = clean(url.searchParams.get("q"), 100);
    const cat = clean(url.searchParams.get("category"), 80);
    const city = clean(url.searchParams.get("city"), 80);

    if (q) {
      where.push("(l.title LIKE ? OR l.description LIKE ? OR l.category LIKE ? OR l.city LIKE ?)");
      args.push(`%${q}%`, `%${q}%`, `%${q}%`, `%${q}%`);
    }
    if (cat) {
      where.push("l.category=?");
      args.push(cat);
    }
    if (city) {
      where.push("l.city LIKE ?");
      args.push(`%${city}%`);
    }

    const r = await db.prepare(`
      SELECT l.id,l.title,l.description,l.category,l.price,l.city,
             l.image_url,l.contact_phone,l.created_at
      FROM listings l
      WHERE ${where.join(" AND ")}
      ORDER BY l.created_at DESC LIMIT 100
    `).bind(...args).all();

    return json({ ok: true, listings: r.results });
  }

  if (path === "/api/listings" && method === "POST") {
    const u = await userFrom(request, env);
    if (!u) return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    const b = await request.json();

    const title = clean(b.title, 150);
    const description = clean(b.description, 5000);
    const category = clean(b.category, 80);
    const city = clean(b.city, 80);
    const image = clean(b.imageUrl, 1000);
    const contact = phone(b.contactPhone);
    const price = Number(b.price || 0);

    if (title.length < 3 || description.length < 5 ||
        category.length < 2 || city.length < 2 ||
        !Number.isSafeInteger(price) || price < 0 ||
        (image && !/^https:\/\/\S+$/i.test(image)) ||
        (contact && !/^09\d{9}$/.test(contact))) {
      return json({ ok: false, error: "INVALID_LISTING" }, 400);
    }

    const plan = await currentPlan(db, u.id);
    const count = await listingCount(db, u.id);
    if (count >= plan.limit) {
      return json({ ok: false, error: "PLAN_LIMIT_REACHED" }, 403);
    }

    const listingId = id();
    await db.prepare(`
      INSERT INTO listings
      (id,seller_id,title,description,category,price,city,image_url,
       contact_phone,status,created_at,updated_at)
      VALUES (?,?,?,?,?,?,?,?,?,'pending',?,?)
    `).bind(
      listingId, u.id, title, description, category, price, city,
      image, contact, now(), now()
    ).run();

    return json({
      ok: true,
      id: listingId,
      status: "pending",
      message: "آگهی ثبت شد و پس از تأیید مدیر منتشر می‌شود."
    }, 201);
  }

  if (path === "/api/my-listings" && method === "GET") {
    const u = await userFrom(request, env);
    if (!u) return json({ ok: false, error: "UNAUTHORIZED" }, 401);

    const r = await db.prepare(`
      SELECT id,title,description,category,price,city,image_url,
             contact_phone,status,created_at
      FROM listings WHERE seller_id=?
      ORDER BY created_at DESC LIMIT 200
    `).bind(u.id).all();

    return json({ ok: true, listings: r.results });
  }

  const remove = path.match(/^\/api\/listings\/([a-f0-9-]{36})\/delete$/i);
  if (remove && method === "POST") {
    const u = await userFrom(request, env);
    if (!u) return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    const r = await db.prepare(`
      UPDATE listings SET status='disabled',updated_at=?
      WHERE id=? AND seller_id=?
    `).bind(now(), remove[1], u.id).run();
    if (!r.meta.changes) {
      return json({ ok: false, error: "LISTING_NOT_FOUND" }, 404);
    }
    return json({ ok: true });
  }

  if (path === "/api/subscriptions/request" && method === "POST") {
    const u = await userFrom(request, env);
    if (!u) return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    const b = await request.json();
    const planId = clean(b.plan, 30);
    const reference = clean(b.reference, 100);
    const plan = PLANS[planId];

    if (!plan || planId === "free" || reference.length < 3) {
      return json({ ok: false, error: "INVALID_REQUEST" }, 400);
    }
    const pending = await db.prepare(`
      SELECT id FROM subscription_requests
      WHERE user_id=? AND status='pending' LIMIT 1
    `).bind(u.id).first();
    if (pending) {
      return json({ ok: false, error: "PENDING_REQUEST_EXISTS" }, 409);
    }

    await db.prepare(`
      INSERT INTO subscription_requests
      (id,user_id,plan,amount,payment_reference,status,created_at)
      VALUES (?,?,?,?,?,'pending',?)
    `).bind(id(), u.id, planId, plan.price, reference, now()).run();

    return json({ ok: true, status: "pending" }, 201);
  }

  if (path === "/api/subscriptions/mine" && method === "GET") {
    const u = await userFrom(request, env);
    if (!u) return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    const r = await db.prepare(`
      SELECT id,plan,amount,payment_reference,status,created_at,reviewed_at
      FROM subscription_requests WHERE user_id=?
      ORDER BY created_at DESC LIMIT 50
    `).bind(u.id).all();
    return json({
      ok: true, requests: r.results,
      activePlan: await currentPlan(db, u.id)
    });
  }

  if (path === "/api/admin/listings" && method === "GET") {
    if (!admin(request, env)) {
      return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    }
    const r = await db.prepare(`
      SELECT l.*,u.phone AS seller_account_phone
      FROM listings l JOIN users u ON u.id=l.seller_id
      ORDER BY l.created_at DESC LIMIT 200
    `).all();
    return json({ ok: true, listings: r.results });
  }

  const reviewListing = path.match(/^\/api\/admin\/listings\/([a-f0-9-]{36})\/review$/i);
  if (reviewListing && method === "POST") {
    if (!admin(request, env)) {
      return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    }
    const b = await request.json();
    const status = String(b.status || "");
    if (!["published", "rejected", "disabled"].includes(status)) {
      return json({ ok: false, error: "INVALID_STATUS" }, 400);
    }
    const r = await db.prepare(
      "UPDATE listings SET status=?,updated_at=? WHERE id=?"
    ).bind(status, now(), reviewListing[1]).run();
    if (!r.meta.changes) return json({ ok: false, error: "NOT_FOUND" }, 404);
    return json({ ok: true, status });
  }

  if (path === "/api/admin/subscriptions" && method === "GET") {
    if (!admin(request, env)) {
      return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    }
    const r = await db.prepare(`
      SELECT r.id,r.user_id,u.phone,r.plan,r.amount,
             r.payment_reference,r.status,r.created_at
      FROM subscription_requests r
      JOIN users u ON u.id=r.user_id
      ORDER BY r.created_at DESC LIMIT 200
    `).all();
    return json({ ok: true, requests: r.results });
  }

  const reviewSub = path.match(/^\/api\/admin\/subscriptions\/([a-f0-9-]{36})\/review$/i);
  if (reviewSub && method === "POST") {
    if (!admin(request, env)) {
      return json({ ok: false, error: "UNAUTHORIZED" }, 401);
    }
    const b = await request.json();
    const decision = String(b.status || "");
    if (!["approved", "rejected"].includes(decision)) {
      return json({ ok: false, error: "INVALID_STATUS" }, 400);
    }

    const item = await db.prepare(
      "SELECT * FROM subscription_requests WHERE id=?"
    ).bind(reviewSub[1]).first();
    if (!item) return json({ ok: false, error: "NOT_FOUND" }, 404);
    if (item.status !== "pending") {
      return json({ ok: false, error: "ALREADY_REVIEWED" }, 409);
    }

    if (decision === "approved") {
      const current = await db.prepare(`
        SELECT expires_at FROM subscriptions
        WHERE user_id=? AND status='active' AND expires_at>?
        ORDER BY expires_at DESC LIMIT 1
      `).bind(item.user_id, now()).first();

      const start = current ? new Date(current.expires_at) : new Date();
      const expiry = new Date(start.getTime() + 30 * 86400000);
      const stamp = now();

      await db.batch([
        db.prepare(`
          UPDATE subscription_requests
          SET status='approved',reviewed_at=?
          WHERE id=? AND status='pending'
        `).bind(stamp, item.id),
        db.prepare(`
          UPDATE subscriptions SET status='expired'
          WHERE user_id=? AND status='active'
        `).bind(item.user_id),
        db.prepare(`
          INSERT INTO subscriptions
          (id,user_id,plan,starts_at,expires_at,status,created_at)
          VALUES (?,?,?,?,?,'active',?)
        `).bind(id(), item.user_id, item.plan, start.toISOString(),
          expiry.toISOString(), stamp)
      ]);
    } else {
      await db.prepare(`
        UPDATE subscription_requests SET status='rejected',reviewed_at=?
        WHERE id=? AND status='pending'
      `).bind(now(), item.id).run();
    }
    return json({ ok: true, status: decision });
  }

  return json({ ok: false, error: "NOT_FOUND" }, 404);
}

export default {
  async fetch(request, env) {
    try {
      return await route(request, env);
    } catch (e) {
      console.error("Kalano error:", e);
      return json({
        ok: false,
        error: "INTERNAL_ERROR",
        message: "خطای سرور؛ گزارش Worker را بررسی کنید."
      }, 500);
    }
  }
};
